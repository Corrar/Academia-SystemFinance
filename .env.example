# ===== Academia =====
ACADEMIA_NOME=Academia Força Total
ACADEMIA_TELEFONE=(11) 99999-0000
CHAVE_PIX=financeiro@academia.com.br

# Login do painel (TROQUE em produção)
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
# Se ficar vazio, o sistema gera uma chave aleatória e guarda em .secret_key
SECRET_KEY=
# Use 1 quando o sistema estiver publicado com HTTPS (cookie só trafega criptografado)
COOKIE_SEGURO=0

# ===== Regras de cobrança =====
# Dias de atraso para entrar no painel de inadimplentes
DIAS_INADIMPLENCIA=10
# Dias relativos ao vencimento em que o aviso automático é enviado
# (negativo = antes, 0 = no dia, positivo = depois)
DIAS_AVISO=-3,0,3,10
# Hora do dia (0-23) em que a cobrança automática roda
HORA_COBRANCA=9
# Depois do último dia acima, no máximo N lembretes semanais (evita cobrança abusiva)
MAX_LEMBRETES_SEMANAIS=4
# Dias que o histórico de avisos fica guardado (minimização de dados - LGPD)
RETENCAO_AVISOS_DIAS=365

# ===== E-mail (SMTP) =====
# Deixe SMTP_HOST vazio para modo SIMULADO (só registra, não envia)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# tls (porta 587) ou ssl (porta 465)
SMTP_SEGURANCA=tls

# ===== WhatsApp =====
# Provedor: simulado | zapi | evolution | meta | twilio
WHATSAPP_PROVEDOR=simulado

# Z-API (https://z-api.io)
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (self-hosted)
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=

# Meta WhatsApp Cloud API
META_TOKEN=
META_PHONE_ID=
# Nome do template aprovado (obrigatório p/ mensagens fora da janela de 24h).
# Se vazio, envia texto livre.
META_TEMPLATE=
META_TEMPLATE_IDIOMA=pt_BR

# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMERO=+14155238886
